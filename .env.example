# Copy to .env (gitignored). Read by app/config.py and docker-compose.yml.
# Every setting is optional: the defaults below work for local development.
# Placeholders only: never put real credentials in this file.

# Local model (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=60

# Longest log the API accepts, in characters
MAX_LOG_CHARS=200000

# Action Agent (v0.3). Real (non-dry-run) actions stay off unless this is true.
ACTIONS_ENABLED=false
# Where the audit log, local ticket store and notification outbox are written
RUNTIME_DIR=var
# Channels the notify tool may post to (comma-separated allowlist)
NOTIFY_CHANNELS=ci-alerts,oncall

# Neo4j knowledge graph (optional, v0.2.5). Local development credentials only.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pipeline-medic-dev
